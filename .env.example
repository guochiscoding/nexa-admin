# Demo mode accepts any non-empty account and password and does not require a backend.
VITE_AUTH_MOCK=true

# Set this when connecting Nexa Admin to a real backend service.
VITE_API_BASE_URL=

# Optional Iconfont script URL. Keep empty to use Nexa Admin's default icon set.
VITE_ICONFONT_SCRIPT_URL=

# Optional comma-separated dev-server host allowlist, for example: localhost,127.0.0.1
ALLOWED_HOSTS=
